        "code": "module.exports = async (args) => {\n  const https = require(\"https\");\n  const webhookUrl = \"https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN\";\n\n  const formatSize = (mb) => {\n    if (mb === undefined || mb === null || isNaN(mb)) return \"0 MB\";\n    const abs = Math.abs(mb);\n    if (abs >= 1024) return (abs / 1024).toFixed(2) + \" GB (\" + abs.toFixed(0) + \" MB)\";\n    return abs.toFixed(2) + \" MB\";\n  };\n\n  const formatDuration = (ms) => {\n    if (!ms || ms < 0) return \"0s\";\n    const totalSec = Math.max(1, Math.round(ms / 1000));\n    const h = Math.floor(totalSec / 3600);\n    const m = Math.floor((totalSec % 3600) / 60);\n    const s = totalSec % 60;\n    if (h > 0) return `${h}h ${m}m ${s}s`;\n    if (m > 0) return `${m}m ${s}s`;\n    return `${s}s`;\n  };\n\n  const flowStartTs = args.variables?.user?.flow_start_ts || args.originalLibraryFile?.createdAt || Date.now();\n  const totalFlowMs = Date.now() - flowStartTs;\n\n  const transcodeStartTs = args.variables?.user?.transcode_start_ts;\n  const transcodeEndTs = args.variables?.user?.transcode_end_ts;\n\n  const vStream = args.originalLibraryFile?.ffProbeData?.streams?.find(s => s.codec_type === \"video\");\n  const totalFrames = parseInt(vStream?.tags?.NUMBER_OF_FRAMES || vStream?.tags?.[\"NUMBER_OF_FRAMES-eng\"] || vStream?.nb_frames || 0, 10);\n\n  let timeTakenStr = \"\";\n  if (transcodeStartTs && transcodeEndTs) {\n    const transcodeMs = Math.max(1, transcodeEndTs - transcodeStartTs);\n    const transcodeSec = Math.max(1, transcodeMs / 1000);\n    const fpsStr = (totalFrames > 0 && transcodeSec > 2) ? ` @ ~${Math.round(totalFrames / transcodeSec)} FPS` : \"\";\n    timeTakenStr = `${formatDuration(totalFlowMs)} (Transcode: ${formatDuration(transcodeMs)}${fpsStr})`;\n  } else {\n    timeTakenStr = `${formatDuration(totalFlowMs)} (Remux only)`;\n  }\n\n  const filePath = args.inputFileObj?._id || args.originalLibraryFile?._id || \"Unknown file\";\n  const fileName = filePath.split(\"/\").pop();\n  \n  const origMB = args.originalLibraryFile?.file_size || 0;\n  const newMB = args.inputFileObj?.file_size || 0;\n  const pipelineMode = args.variables?.user?.qsv_mode || (transcodeStartTs && transcodeEndTs ? \"Full QSV Hardware\" : \"Library Reprocessing: Dual-Audio & Subtitle Normalization (Remux Only)\");\n  \n  let ratioStr = \"N/A\";\n  let savedStr = \"\";\n  if (origMB > 0 && newMB > 0) {\n    const ratio = ((newMB / origMB) * 100).toFixed(1);\n    ratioStr = `${ratio}% of original`;\n    const diffMB = origMB - newMB;\n    if (diffMB > 0) {\n      const pctSaved = (100 - ratio).toFixed(1);\n      savedStr = `\\n**Space Saved:** ${formatSize(diffMB)} (${pctSaved}% reduction)`;\n    } else if (diffMB < 0) {\n      const pctAdded = (ratio - 100).toFixed(1);\n      savedStr = `\\n**Size Change:** +${formatSize(Math.abs(diffMB))} (+${pctAdded}% - added audio/streams)`;\n    } else {\n      savedStr = `\\n**Size Change:** 0 MB (identical size)`;\n    }\n  }\n\n  const payload = JSON.stringify({\n    embeds: [{\n      title: (transcodeStartTs && transcodeEndTs) ? \"✅ Transcode Successful (AV1)\" : \"✅ Reprocess Successful (AV1 Remux)\",\n      description: `**File:** \\`${fileName}\\`\\n**Path:** \\`${filePath}\\`\\n\\n**Codec:** AV1\\n**Pipeline:** ${pipelineMode}\\n**Time Taken:** ${timeTakenStr}\\n**Original Size:** ${formatSize(origMB)}\\n**New Size:** ${formatSize(newMB)} (${ratioStr})${savedStr}\\n\\n**Status:** ${(transcodeStartTs && transcodeEndTs) ? \"Transcoded and replaced original file successfully.\" : \"Reprocessed audio/subtitles and replaced original file successfully.\"}`,\n      color: 3066993,\n      footer: {\n        text: \"Tdarr AV1 Flow • Transcode Success\"\n      },\n      timestamp: new Date().toISOString()\n    }]\n  });\n\n  try {\n    const url = new URL(webhookUrl);\n    await new Promise((resolve) => {\n      const req = https.request({\n        hostname: url.hostname,\n        path: url.pathname + url.search,\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"User-Agent\": \"Tdarr-DiscordNotifier/1.0\",\n          \"Content-Length\": Buffer.byteLength(payload)\n        }\n      }, (res) => {\n        let body = \"\";\n        res.on(\"data\", chunk => { body += chunk; });\n        res.on(\"end\", () => {\n          if (res.statusCode >= 400) {\n            console.error(`[Discord Success Error] HTTP ${res.statusCode}: ${body}`);\n          } else {\n            console.log(`[Discord Success Notification] Sent successfully (HTTP ${res.statusCode})`);\n          }\n          resolve();\n        });\n      });\n      req.on(\"error\", (err) => {\n        console.error(\"[Discord Webhook Error]\", err);\n        resolve();\n      });\n      req.setTimeout(5000, () => { req.destroy(); resolve(); });\n      req.write(payload);\n      req.end();\n    });\n  } catch (e) {\n    console.error(\"[Discord Success Notifier] Exception:\", e);\n  }\n\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: 1,\n    variables: args.variables\n  };\n};"
