    {
      "name": "INTEL QSV COMPATIBILITY & HYBRID ROUTER",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  const videoStream = args.inputFileObj?.ffProbeData?.streams?.find(s => s.codec_type === 'video');\n\n  const rawPixFmt = (videoStream?.pix_fmt || '').toLowerCase();\n  const pixFmt = rawPixFmt.split('(')[0].trim();\n  const codecName = (videoStream?.codec_name || '').toLowerCase();\n\n  // 4:2:0 pixel formats supported by Intel Arc QSV AV1 hardware encoder\n  const encoderSupportedPixFmts = [\n    'nv12', 'p010', 'p010le', 'yuv420p', 'yuv420p8', 'yuv420p9le',\n    'yuv420p10le', 'yuv420p12le', 'yuv420p16le'\n  ];\n\n  // Formats where Intel Arc lacks hardware decode, requiring CPU software decode -> QSV GPU encode\n  const isH26410bit = (codecName === 'h264' && (pixFmt.includes('10') || videoStream?.bits_per_raw_sample === '10' || videoStream?.bits_per_raw_sample === 10));\n  const isVC1 = (codecName === 'vc1' || codecName === 'wmv3');\n  const isNon420Chroma = pixFmt.includes('444') || pixFmt.includes('422');\n  const needsHybridDecode = isH26410bit || isVC1 || isNon420Chroma;\n\n  const isEncoderCompatible = encoderSupportedPixFmts.includes(pixFmt) || isNon420Chroma;\n\n  if (!args.variables) args.variables = {};\n  if (!args.variables.user) args.variables.user = {};\n\n  let outputNumber = 2;\n\n  if (isEncoderCompatible) {\n    outputNumber = 1;\n    if (isNon420Chroma) {\n      // 4:4:4 or 4:2:2 Chroma -> Downsample in software to 4:2:0 10-bit P010 -> Hardware QSV AV1 Encode\n      args.variables.user.qsv_in = '-qsv_device /dev/dri/renderD129';\n      args.variables.user.qsv_vf = 'format=p010le';\n      args.variables.user.qsv_mode = `Hybrid (${pixFmt} -> 4:2:0 Downsample + Arc QSV AV1 Encode)`;\n    } else if (needsHybridDecode) {\n      // Software CPU Decode -> QSV GPU AV1 Encode (Hi10P or VC-1)\n      args.variables.user.qsv_in = '-qsv_device /dev/dri/renderD129';\n      args.variables.user.qsv_vf = 'format=p010le';\n      args.variables.user.qsv_mode = `Hybrid (CPU Decode [${codecName}] + Arc QSV AV1 Encode)`;\n    } else {\n      // Full Hardware Mode: QSV Decode + QSV AV1 Encode on renderD129\n      args.variables.user.qsv_in = '-hwaccel qsv -qsv_device /dev/dri/renderD129 -hwaccel_output_format qsv -extra_hw_frames 40';\n      args.variables.user.qsv_vf = 'vpp_qsv=format=p010';\n      args.variables.user.qsv_mode = 'Full QSV Hardware (GPU Decode + GPU Encode)';\n    }\n  }\n\n  console.log(`[Custom QSV Router] Codec: ${codecName} | PixFmt: ${pixFmt} | Hybrid: ${needsHybridDecode} | Mode: ${args.variables.user.qsv_mode || 'Incompatible'} -> Output ${outputNumber}`);\n\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: outputNumber,\n    variables: args.variables\n  };\n};"
      },
