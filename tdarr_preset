        "code": "const fs = require(\"fs\");\nconst { execSync } = require(\"child_process\");\nconst path = require(\"path\");\n\nmodule.exports = async (args) => {\n  const streams = args.inputFileObj?.ffProbeData?.streams || [];\n  const hasAss = streams.some(s => s.codec_type === \"subtitle\" && [\"ass\", \"ssa\"].includes((s.codec_name || \"\").toLowerCase()));\n\n  if (!hasAss) {\n    return {\n      outputFileObj: args.inputFileObj,\n      outputNumber: 1,\n      variables: args.variables\n    };\n  }\n\n  const inputPath = args.inputFileObj?._id;\n  if (!inputPath || !fs.existsSync(inputPath)) {\n    return {\n      outputFileObj: args.inputFileObj,\n      outputNumber: 1,\n      variables: args.variables\n    };\n  }\n\n  console.log(`[Subtitle Normalizer] Converting ASS/SSA subtitles to SRT in AV1 file: ${inputPath}`);\n\n  try {\n    const parsed = path.parse(inputPath);\n    const outputPath = path.join(parsed.dir, `${parsed.name}_norm${parsed.ext}`);\n\n    let subIndex = 0;\n    const subArgs = [];\n    streams.forEach(s => {\n      if (s.codec_type === \"subtitle\") {\n        const codec = (s.codec_name || \"\").toLowerCase();\n        if (codec === \"ass\" || codec === \"ssa\") {\n          subArgs.push(`-c:s:${subIndex} srt`);\n        } else {\n          subArgs.push(`-c:s:${subIndex} copy`);\n        }\n        subIndex++;\n      }\n    });\n\n    const ffmpegCmd = `ffmpeg -y -i \"${inputPath}\" -c:v copy -c:a copy -c:s copy ${subArgs.join(\" \")} \"${outputPath}\"`;\n    execSync(ffmpegCmd, { stdio: \"ignore\" });\n\n    if (fs.existsSync(outputPath) && fs.statSync(outputPath).size > 1000) {\n      fs.unlinkSync(inputPath);\n      fs.renameSync(outputPath, inputPath);\n      console.log(`[Subtitle Normalizer] Successfully normalized subtitles in ${inputPath}`);\n      if (args.variables?.user) {\n        args.variables.user.qsv_mode = \"Library Reprocessing: Dual-Audio & Subtitle Normalization (Remux Only)\";\n      }\n    }\n  } catch (e) {\n    console.error(\"[Subtitle Normalizer] Failed to convert ASS to SRT:\", e);\n  }\n\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: 1,\n    variables: args.variables\n  };\n};"
